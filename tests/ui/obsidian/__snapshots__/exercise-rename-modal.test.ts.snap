exports[`ExerciseRenameModal input stage > draws the explanation, the name field and the actions 1`] = `
"div.fitkit-import-modal
  p.fitkit-import-muted
    "Renaming 'Row' updates its exercise note file, rewrites '[exercise:: [[Row]]]' references in workout notes, and keeps 'Row' as an alias. Renaming onto a name already in use merges the two."
  div.fitkit-registry-field
    label.fitkit-registry-field-label
      "New name"
    input.fitkit-registry-input[type=text]
  div.fitkit-import-actions
    button.fitkit-btn
      "Cancel"
    button.fitkit-btn.fitkit-btn-primary
      "Preview changes""
`;

exports[`ExerciseRenameModal input stage > returns to the input with the error when the vault cannot be read 1`] = `
"div.fitkit-import-modal
  p.fitkit-import-muted
    "Renaming 'Row' updates its exercise note file, rewrites '[exercise:: [[Row]]]' references in workout notes, and keeps 'Row' as an alias. Renaming onto a name already in use merges the two."
  div.fitkit-registry-field
    label.fitkit-registry-field-label
      "New name"
    input.fitkit-registry-input[type=text]
  div.fitkit-warn
    "Could not check the vault: Disk gone."
  div.fitkit-import-actions
    button.fitkit-btn
      "Cancel"
    button.fitkit-btn.fitkit-btn-primary
      "Preview changes""
`;

