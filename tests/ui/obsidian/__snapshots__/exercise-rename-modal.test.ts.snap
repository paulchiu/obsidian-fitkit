// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ExerciseRenameModal confirm > disables the actions and says Applying while the rename runs 1`] = `
"div.fitkit-import-modal
  p
    "Renaming 'Row' to 'Barbell Row'."
  h3
    "Exercise note file"
  p
    "Rename: 'Fitness/Exercises/Row.md' → 'Fitness/Exercises/Barbell Row.md'."
  h3
    "Workout notes (1)"
  table.fitkit-import-table
    tr
      th
        "Workout note"
      th
        "Rows changed"
      th
        "Left stale"
    tr
      td
        "Fitness/Workouts/2026-05-08.md"
      td
        "3"
      td
  p.fitkit-import-muted
    "3 row(s) across 1 workout note(s) will be updated."
  h3
    "Alias"
  p
    "'Row' will be kept as an alias of 'Barbell Row', so existing references still resolve."
  h3
    "Left stale"
  p
    "No references will be left stale."
  div.fitkit-import-actions
    button.fitkit-btn[disabled=]
      "Back"
    button.fitkit-btn[disabled=]
      "Cancel"
    button.fitkit-btn.fitkit-btn-primary[disabled=]
      "Applying...""
`;

