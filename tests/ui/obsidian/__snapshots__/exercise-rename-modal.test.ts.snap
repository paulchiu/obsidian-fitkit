exports[`ExerciseRenameModal preview > names what happens to the losing note and its prose on a merge 1`] = `
"div.fitkit-import-modal
  p
    "Merging 'Row' into 'Barbell Row'."
  h3
    "Exercise note file"
  p
    "'Fitness/Exercises/Row.md' will be removed after merging into 'Fitness/Exercises/Barbell Row.md'."
  h3
    "Workout notes (1)"
  table.fitkit-import-table
    tr
      th
        "Workout note"
      th
        "Rows changed"
      th
        "Left stale"
    tr
      td
        "Fitness/Workouts/2026-05-08.md"
      td
        "3"
      td
  p.fitkit-import-muted
    "3 row(s) across 1 workout note(s) will be updated."
  h3
    "Alias"
  p
    "'Row' will be kept as an alias of 'Barbell Row', so existing references still resolve."
  p.fitkit-import-muted
    "Other aliases carried over: Rows."
  h3
    "Left stale"
  p
    "No references will be left stale."
  h3
    "Merge"
  p.fitkit-warn
    "'Fitness/Exercises/Row.md' will be removed. Its Notes section has text, which will be copied into 'Fitness/Exercises/Barbell Row.md' under a 'Merged from Row' heading first."
  div.fitkit-import-actions
    button.fitkit-btn
      "Back"
    button.fitkit-btn
      "Cancel"
    button.fitkit-btn.fitkit-btn-primary
      "Confirm merge""
`;

