exports[`ExerciseRenameModal preview > warns plainly about stale pathed/aliased occurrences instead of silently dropping them 1`] = `
"div.fitkit-import-modal
  p
    "Renaming 'Row' to 'Barbell Row'."
  h3
    "Exercise note file"
  p
    "Rename: 'Fitness/Exercises/Row.md' → 'Fitness/Exercises/Barbell Row.md'."
  h3
    "Workout notes (1)"
  table.fitkit-import-table
    tr
      th
        "Workout note"
      th
        "Rows changed"
      th
        "Left stale"
    tr
      td
        "Fitness/Workouts/2026-05-08.md"
      td
        "0"
      td
        "2"
  p.fitkit-import-muted
    "3 row(s) across 1 workout note(s) will be updated."
  h3
    "Alias"
  p
    "'Row' will be kept as an alias of 'Barbell Row', so existing references still resolve."
  h3
    "Left stale"
  p.fitkit-warn
    "2 reference(s) use a pathed or aliased wikilink (for example '[[Folder/Row]]' or '[[Row|Display]]') and will not be rewritten here. Obsidian's own link updater may fix these when the note file is renamed; check them if not."
  div.fitkit-import-actions
    button.fitkit-btn
      "Back"
    button.fitkit-btn
      "Cancel"
    button.fitkit-btn.fitkit-btn-primary
      "Confirm rename""
`;
