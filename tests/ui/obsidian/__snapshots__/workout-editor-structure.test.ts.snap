exports[`WorkoutEditorView structure > draws a bodyweight card 1`] = `
"div.fitkit-card.fitkit-bodyweight-card[data-exercise-index=0]
  div.fitkit-card-top
    button.fitkit-drag-handle[aria-label=Drag to reorder][data-icon=grip-vertical][tabindex=0][type=button]
    button.fitkit-name-button[aria-label=Open exercise file for Push-up][type=button]
      span.fitkit-name-button-text
        "Push-up"
      span.fitkit-name-button-icon[aria-hidden=true][data-icon=arrow-up-right]
    button.fitkit-btn.fitkit-btn-muted.fitkit-card-icon-button.fitkit-gear-button[aria-label=Exercise options][data-icon=settings][type=button]
  div.fitkit-set-area
    div.fitkit-bodyweight-row.fitkit-set-head.has-load
      span.fitkit-set-label.fitkit-set-figure
      span.fitkit-set-label
        "Level"
      span.fitkit-set-label
        "Reps"
      span.fitkit-set-label
        "Load"
      span.fitkit-bodyweight-head-spacer[aria-hidden=true]
    div.fitkit-set-rows[style=--fitkit-set-cap: 384px;]
      div.fitkit-row
        div.fitkit-row-body
          div.fitkit-bodyweight-row.has-load
            div.fitkit-cell.fitkit-set-figure[data-label=Set]
              "1"
            div.fitkit-cell[data-label=Level]
              div.fitkit-bodyweight-stepper
                button.fitkit-btn.fitkit-bodyweight-step[aria-label=Lower level for set 1][data-icon=minus][type=button]
                button.fitkit-bodyweight-level-label[aria-haspopup=menu][aria-label=Level for set 1: 2 · Incline push-up][type=button]
                  span.fitkit-bodyweight-level-full
                    "2 · Incline push-up"
                  span.fitkit-bodyweight-level-short
                    "L2"
                  span.fitkit-bodyweight-level-chevron[aria-hidden=true][data-icon=chevron-down]
                button.fitkit-btn.fitkit-bodyweight-step[aria-label=Raise level for set 1][data-icon=plus][type=button]
            div.fitkit-cell[data-label=Reps]
              input.fitkit-input[aria-label=Reps][inputmode=numeric][type=number]
            div.fitkit-cell.fitkit-bodyweight-load[data-label=Load]
              input.fitkit-input[aria-label=Load][inputmode=decimal][step=0.1][type=number]
          button.fitkit-btn.fitkit-btn-muted.fitkit-row-kebab[aria-label=Options for bodyweight entry 1][data-icon=more-vertical][type=button]
      div.fitkit-row
        div.fitkit-row-body
          div.fitkit-bodyweight-row.has-load
            div.fitkit-cell.fitkit-set-figure[data-label=Set]
              "2"
            div.fitkit-cell[data-label=Level]
              div.fitkit-bodyweight-stepper
                button.fitkit-btn.fitkit-bodyweight-step[aria-label=Lower level for set 2][data-icon=minus][type=button]
                button.fitkit-bodyweight-level-label[aria-haspopup=menu][aria-label=Level for set 2: 3 · Knee push-up][type=button]
                  span.fitkit-bodyweight-level-full
                    "3 · Knee push-up"
                  span.fitkit-bodyweight-level-short
                    "L3"
                  span.fitkit-bodyweight-level-chevron[aria-hidden=true][data-icon=chevron-down]
                button.fitkit-btn.fitkit-bodyweight-step[aria-label=Raise level for set 2][data-icon=plus][disabled=][type=button]
            div.fitkit-cell[data-label=Reps]
              input.fitkit-input[aria-label=Reps][inputmode=numeric][type=number]
            div.fitkit-cell.fitkit-bodyweight-load[data-label=Load]
          button.fitkit-btn.fitkit-btn-muted.fitkit-row-kebab[aria-label=Options for bodyweight entry 2][data-icon=more-vertical][type=button]
    button.fitkit-btn.fitkit-btn-muted.fitkit-set-toggle[aria-expanded=true][hidden=][type=button]
      "Show fewer sets"
    div.fitkit-row-actions
      button.fitkit-btn
        "Add set"
      button.fitkit-btn
        "Repeat""
`;

