exports[`WorkoutEditorView timer screen structure > draws the set timer stopped on a set after another 1`] = `
"div.fitkit-runner.is-work.is-paused
  div.fitkit-runner-top
    span.fitkit-runner-phase
      "Set 2"
    span.fitkit-runner-name
      "Rowing"
  div.fitkit-runner-center
    div.fitkit-runner-clock
      "0:25"
    div.fitkit-runner-stats
      "Last set 1m55s"
    div.fitkit-runner-note
      "Stopped"
  button.fitkit-btn.fitkit-runner-primary.fitkit-btn-primary[aria-label=Next set][type=button]
    "Next set"
  div.fitkit-runner-controls.is-three
    button.fitkit-btn[aria-label=Resume timer][type=button]
      span.fitkit-runner-icon[data-icon=play]
      span
        "Resume"
    button.fitkit-btn[aria-label=Reset set][type=button]
      span.fitkit-runner-icon[data-icon=rotate-ccw]
      span
        "Reset"
    button.fitkit-btn[aria-label=Close timer][type=button]
      span.fitkit-runner-icon[data-icon=check]
      span
        "Done""
`;

