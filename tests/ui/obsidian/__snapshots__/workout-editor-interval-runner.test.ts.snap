// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`WorkoutEditorView interval runner > draws the runner cut off during rest 1`] = `
"div.fitkit-runner.is-cut-off
  div.fitkit-runner-banner
    div.fitkit-runner-phase
      "Run cut off at rep 1 rest"
    div.fitkit-runner-note
      "Obsidian closed during rep 1 rest of Exercise Bike, and the clock has since passed the end of the plan, so no reps were filled in."
  button.fitkit-btn.fitkit-btn-primary.fitkit-runner-primary[type=button]
    "Resume rep 2"
  button.fitkit-btn[type=button]
    "End run here""
`;

