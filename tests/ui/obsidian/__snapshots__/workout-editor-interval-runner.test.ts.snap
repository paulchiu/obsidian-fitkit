exports[`WorkoutEditorView interval runner > draws the runner resting on a plan with no intensity 1`] = `
"div.fitkit-runner.is-rest
  div.fitkit-runner-top
    span.fitkit-runner-phase
      "Rest · rep 1 of 3"
    span.fitkit-runner-name
      "Exercise Bike"
  div.fitkit-runner-center
    div.fitkit-runner-clock
      "1:29"
    div.fitkit-runner-target
      "rest"
    div.fitkit-runner-next
      "Next: work 30s"
    div.fitkit-runner-dots[style=--fitkit-reps: 3;]
      span.fitkit-runner-dot.is-done
      span.fitkit-runner-dot
      span.fitkit-runner-dot
  button.fitkit-btn.fitkit-runner-primary[type=button]
    "Skip"
  div.fitkit-runner-controls
    button.fitkit-btn[aria-label=Pause run][type=button]
      span.fitkit-runner-icon[data-icon=pause]
      span
        "Pause"
    button.fitkit-btn[aria-label=End run][type=button]
      span.fitkit-runner-icon[data-icon=square]
      span
        "End run""
`;

exports[`WorkoutEditorView interval runner > draws the runner resting while paused 1`] = `
"div.fitkit-runner.is-rest.is-paused
  div.fitkit-runner-top
    span.fitkit-runner-phase
      "Rest · rep 1 of 3"
    span.fitkit-runner-name
      "Exercise Bike"
  div.fitkit-runner-center
    div.fitkit-runner-clock
      "1:30"
    div.fitkit-runner-target
      "rest"
    div.fitkit-runner-next
      "Next: 30s @ 300W"
    div.fitkit-runner-dots[style=--fitkit-reps: 3;]
      span.fitkit-runner-dot.is-miss
      span.fitkit-runner-dot
      span.fitkit-runner-dot
    div.fitkit-runner-stats
      "Last 300 W · avg 300 W"
    div.fitkit-runner-note
      "Paused"
    div.fitkit-runner-stepper
      button.fitkit-btn[aria-label=Lower last rep][type=button]
        "−"
      span.fitkit-runner-stepper-value
        "Rep 1: 300 W"
      button.fitkit-btn[aria-label=Raise last rep][type=button]
        "+"
  button.fitkit-btn.fitkit-runner-primary[disabled=][type=button]
    "Skip"
  div.fitkit-runner-controls
    button.fitkit-btn[aria-label=Resume run][type=button]
      span.fitkit-runner-icon[data-icon=play]
      span
        "Resume"
    button.fitkit-btn[aria-label=End run][type=button]
      span.fitkit-runner-icon[data-icon=square]
      span
        "End run""
`;

