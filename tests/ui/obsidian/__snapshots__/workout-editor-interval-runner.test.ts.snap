exports[`WorkoutEditorView interval runner > draws the runner finished with no targets 1`] = `
"div.fitkit-runner.is-finished
  div.fitkit-runner-top
    span.fitkit-runner-phase
      "Run finished"
    span.fitkit-runner-name
      "Exercise Bike"
  div.fitkit-runner-center
    div.fitkit-runner-hits
      "1"
    div.fitkit-runner-target
      "reps done"
    div.fitkit-runner-dots[style=--fitkit-reps: 1;]
      span.fitkit-runner-dot.is-done
  button.fitkit-btn.fitkit-btn-primary.fitkit-runner-primary[type=button]
    "Back to workout""
`;

exports[`WorkoutEditorView interval runner > draws the runner finished, scored against targets 1`] = `
"div.fitkit-runner.is-finished
