// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`interval plan modal > structure > draws a plan the rows cannot show as text, with its note and Clear plan 1`] = `
"div.fitkit-set-note-modal
  div.fitkit-plan-heading
    span.fitkit-label
      "Plan"
    button.fitkit-plan-info[aria-expanded=false][aria-label=Plan examples][type=button]
    div.fitkit-plan-modes
      button.fitkit-btn[aria-pressed=false][type=button]
        "Steps"
      button.fitkit-btn[aria-pressed=true][type=button]
        "Text"
  div.fitkit-plan-builder[hidden=]
  textarea.fitkit-input.fitkit-plan-text[aria-label=Plan][autocapitalize=off][rows=3][spellcheck=false]
  div.fitkit-plan-note
    "This plan can't be shown as steps, so edit it as text."
  div.fitkit-plan-preview
    "1 rep · 40s"
  div.fitkit-plan-examples[hidden=]
    div.fitkit-plan-example
      code
        "(x 8 (work 20s 400W) (rest 10s))"
      div.fitkit-plan-example-about
        "Eight reps of 20s at 400W. A rest at the end of an x goes between rounds."
      button.fitkit-btn
        "Use this"
    div.fitkit-plan-example
      code
        "(x 3 (over 1m 300W) (under 2m 220W))"
      div.fitkit-plan-example-about
        "The first word names the step. Steps with no rest between them run straight on."
      button.fitkit-btn
        "Use this"
    div.fitkit-plan-example
      code
        "(warmup 10m 150W) (x 3 (x 3 (over 1m 300W) (under 2m 220W)) (rest 4m)) (cooldown 5m 120W)"
      div.fitkit-plan-example-about
        "Nest x for sets of rounds. A step with no target, like (spin 5m), is timed but not scored."
      button.fitkit-btn
        "Use this"
    div.fitkit-plan-example
      code
        "(x 6 (climb 1m (L8 L10 L12 L14 L12 L10)) (rest 1m))"
      div.fitkit-plan-example-about
        "A list of targets takes the next one each round."
      button.fitkit-btn
        "Use this"
    div.fitkit-plan-example
      code
        "(x 6 (every 2m (push open 120kg)))"
      div.fitkit-plan-example-about
        "Open work ends when you tap Rest. Every starts each rep on the clock."
      button.fitkit-btn
        "Use this"
    div.fitkit-plan-example
      code
        "("big gear" 2m 260W)"
      div.fitkit-plan-example-about
        "Quote a name with spaces. Targets are watts (300W), load (120kg) or a level (L12)."
      button.fitkit-btn
        "Use this"
    div.fitkit-plan-example
      code
        "8 x 30s @ 300W, 90s rest"
      div.fitkit-plan-example-about
        "The one-line form still works for a single repeat."
      button.fitkit-btn
        "Use this"
    a[href=https://github.com/paulchiu/obsidian-fitkit/blob/main/docs/interval-training.md#plan-syntax]
      "Full syntax and more examples"
  div.fitkit-confirm-actions.fitkit-set-note-actions
    button.fitkit-btn
      "Clear plan"
    button.fitkit-btn
      "Cancel"
    button.fitkit-btn.fitkit-btn-primary
      "Save""
`;

exports[`interval plan modal > structure > draws the examples once opened 1`] = `
