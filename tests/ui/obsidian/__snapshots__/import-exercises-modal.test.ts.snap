// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ImportExercisesModal > keeps the modal open with a warning when applying fails 1`] = `
"div.fitkit-import-modal
  p.fitkit-import-muted
    "Review exercise names found in workout notes and choose which exercise notes or no-note registry entries to create."
  div.fitkit-warn
    "Import failed before settings were saved. The modal stayed open so you can review selections before applying again."
  table.fitkit-import-table
    thead
      tr
        th
          "Exercise"
        th
          "Kind"
        th
          "Registry"
        th
          "Note file"
        th
          "Actions"
    tbody
      tr
        td[data-label=Exercise]
          span.fitkit-import-cell-label
            "Exercise"
          span
            "Fresh"
        td[data-label=Kind]
          span.fitkit-import-cell-label
            "Kind"
          select.fitkit-import-select[aria-label=Kind for Fresh]
            option[value=strength]
              "Strength"
            option[value=duration]
              "Duration"
            option[value=interval]
              "Interval"
            option[value=bodyweight]
              "Bodyweight"
        td.fitkit-import-status-unknown[data-label=Registry]
          span.fitkit-import-cell-label
            "Registry"
          span
            "Missing"
        td.fitkit-import-status-unknown[data-label=Note file]
          span.fitkit-import-cell-label
            "Note file"
          span
            "Missing"
        td[data-label=Actions]
          span.fitkit-import-cell-label
            "Actions"
          label.fitkit-import-checkbox-row
            input[type=checkbox]
            span
              "Create note"
          label.fitkit-import-checkbox-row
            input[type=checkbox]
            span
              "No-note entry"
  div.fitkit-import-actions
    button.fitkit-btn
      "Cancel"
    button.fitkit-btn.fitkit-btn-primary
      "Apply""
`;

