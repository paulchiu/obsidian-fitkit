exports[`ImportExercisesModal > shows the description and a loading line until the plan arrives 1`] = `
"div.fitkit-import-modal
  p.fitkit-import-muted
    "Review exercise names found in workout notes and choose which exercise notes or no-note registry entries to create."
  div.fitkit-import-muted
    "Loading exercises...""
`;

exports[`ImportExercisesModal > shows the load error with a Close button 1`] = `
"div.fitkit-import-modal
  div.fitkit-warn
    "Could not load exercises: Vault unreadable."
  div.fitkit-import-actions
    button.fitkit-btn
      "Close""
`;
