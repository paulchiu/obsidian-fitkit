// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`workout reading mode structure > draws a bodyweight table with rung names and a load column 1`] = `
"div
  ul
    li.fitkit-reading-hidden-source-row
      "[exercise:: [[Push-up]]] [next:: up 1]"
    li.fitkit-reading-hidden-source-row
      "[exercise:: [[Push-up]]] [set:: 1] [level:: 2] [reps:: 10] [load:: 5]"
    li.fitkit-reading-hidden-source-row
      "[exercise:: [[Push-up]]] [set:: 2] [level:: 4] [reps:: 8] [notes:: slow]"
  div.fitkit-reading-preview
    div.fitkit-reading-summary
      span.fitkit-reading-kind
        "Bodyweight"
      span.fitkit-reading-count
        "2 rows"
    div.fitkit-reading-plan
      "Next time: up 1 rung"
    table.fitkit-reading-table
      thead
        tr
          th
            "Set"
          th
            "Level"
          th
            "Reps"
          th
            "Load"
          th
            "Notes"
      tbody
        tr
          td
            "1"
          td
            "Knee"
          td
            "10"
          td
            "5 kg"
          td
            "-"
        tr
          td
            "2"
          td
            "Level 4"
          td
            "8"
          td
            "-"
          td
            "slow""
`;

exports[`workout reading mode structure > draws a duration table under its plan 1`] = `
"div
  ul
    li.fitkit-reading-hidden-source-row
      "[exercise:: [[Bike]]] [plan:: 3 x 1m @ 300W, 30s rest] [next:: stay 5]"
    li.fitkit-reading-hidden-source-row
      "[exercise:: [[Bike]]] [set:: 1] [duration:: 95]"
    li.fitkit-reading-hidden-source-row
      "[exercise:: [[Bike]]] [set:: 2] [duration:: 3660] [notes:: hard]"
  div.fitkit-reading-preview
    div.fitkit-reading-summary
      span.fitkit-reading-kind
        "Interval"
      span.fitkit-reading-count
        "2 rows"
    div.fitkit-reading-plan
      "Plan: 3 x 1m @ 300W, 30s rest"
    div.fitkit-reading-plan
      "Next time: same target"
    table.fitkit-reading-table
      thead
        tr
          th
            "Set"
          th
            "Duration"
          th
            "Notes"
      tbody
        tr
          td
            "1"
          td
            "1m35s"
          td
            "-"
        tr
          td
            "2"
          td
            "1h1m"
          td
            "hard""
`;

exports[`workout reading mode structure > draws a strength table with a note and a next-time plan 1`] = `
