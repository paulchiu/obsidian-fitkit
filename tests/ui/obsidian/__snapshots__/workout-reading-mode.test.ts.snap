exports[`workout reading mode structure > draws the empty message for a duration exercise without rows 1`] = `
"div
  ul
    li.fitkit-reading-hidden-source-row
      "[exercise:: [[Plank]]] [plan:: 3 x 1m]"
  div.fitkit-reading-preview
    div.fitkit-reading-summary
      span.fitkit-reading-kind
        "Interval"
      span.fitkit-reading-count
        "0 rows"
    div.fitkit-reading-plan
      "Plan: 3 x 1m"
    div.fitkit-reading-empty
      "No duration rows recorded.""
`;

