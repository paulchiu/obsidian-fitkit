{
  "name": "fitkit",
  "version": "1.9.0",
  "description": "Track workouts as plain-markdown notes in Obsidian. Uses the Dataview plugin to render dashboard history.",
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && tsc --noEmit -p tsconfig.harness.json && node esbuild.config.mjs production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "fitness",
    "workouts"
  ],
  "license": "MIT",
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "esbuild": "^0.28.2",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  }
}
