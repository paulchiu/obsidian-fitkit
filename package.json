{
  "name": "fitkit",
  "version": "0.3.0",
  "description": "Track workouts as plain-markdown notes in Obsidian. Uses the Dataview plugin to render dashboard history.",
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "fitness",
    "workouts"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^25.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "obsidian": "^1.4.11",
    "prettier": "^3.8.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
